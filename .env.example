# ============================================================================
# Target Application Configuration
# ============================================================================
E2E_BASE_URL=http://localhost:3000
E2E_BROWSER=chromium
E2E_HEADLESS=true
E2E_VIEWPORT_WIDTH=1440
E2E_VIEWPORT_HEIGHT=900

# ============================================================================
# Timeouts (in milliseconds)
# ============================================================================
E2E_TEST_TIMEOUT_MS=60000
E2E_ACTION_TIMEOUT_MS=15000
E2E_NAVIGATION_TIMEOUT_MS=30000

# ============================================================================
# LLM Provider Configuration
# Supported values: openai | anthropic | ollama | gateway
# ============================================================================
E2E_LLM_PROVIDER=openai
E2E_LLM_MODEL=gpt-4o

# OpenAI Credentials
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Credentials (if E2E_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Ollama Configuration (if E2E_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ============================================================================
# Test Account Credentials
# ============================================================================
E2E_USER_EMAIL=qa-member@example.com
E2E_USER_PASSWORD=SuperSecretPassword123!
E2E_ADMIN_EMAIL=qa-admin@example.com
E2E_ADMIN_PASSWORD=AdminSecretPassword123!
